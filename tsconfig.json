{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": [
    "packages/**/*.ts",
    "server/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "projects/**",
    "node_modules",
    "dist"
  ]
}
